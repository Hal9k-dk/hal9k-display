#!/bin/bash
set -eu -o pipefail

browsercmd="{{ kiosk_browser_cmd }}"

# auto-detect sway socket if not in environment
if [ -z "${SWAYSOCK:-}" ]; then
    runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    for s in "$runtime"/sway-ipc.*.sock; do
        export SWAYSOCK="$s"
        break
    done
fi
[ -n "${WAYLAND_DISPLAY:-}" ] || export WAYLAND_DISPLAY=wayland-1

urls=(
{%- for url in kiosk_urls %}
	"{{ url }}"
{%- endfor %}
)

{% raw %}
KF="${XDG_CONFIG_HOME:-$HOME/.config}/firefox-kiosk"

# ensure Firefox kiosk profile exists with session restore disabled
if [ ! -f "$KF/user.js" ]; then
    mkdir -p "$KF"
    cat > "$KF/user.js" <<'PREFS'
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("browser.sessionstore.max_tabs_undo", 0);
user_pref("browser.sessionstore.max_windows_undo", 0);
user_pref("browser.sessionstore.restore_on_demand", false);
user_pref("browser.sessionstore.restore_tabs_lazily", false);
user_pref("browser.sessionstore.restore_pinned_tabs_on_demand", false);
user_pref("browser.startup.page", 0);
user_pref("browser.tabs.warnOnClose", false);
user_pref("browser.tabs.warnOnCloseOtherTabs", false);
user_pref("datareporting.policy.dataSubmissionPolicyBypassNotification", true);
user_pref("app.shield.optoutstudies.enabled", false);
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.rights.3.shown", true);
PREFS
fi

browsercmd="$browsercmd --profile $KF"

# wait for local HTTP server if any kiosk URL depends on it
if printf '%s\n' "${urls[@]}" | grep -q 'localhost:8080'; then
    echo "Waiting for localhost:8080..."
    for i in $(seq 1 60); do
        if curl -s -o /dev/null http://localhost:8080/; then
            break
        fi
        sleep 0.5
    done
fi

swaytree() {
    swaymsg -t get_tree | jq "$@"
}

get_window_ids() {
    local workspace="$1"
    swaytree -r 'recurse(.nodes[])|select(.type=="workspace" and .name=="'$workspace'")|recurse(.nodes[])|select(.type=="con" and (.app_id=="firefox" or .app_id=="chromium"))|.id'
}

any_windows() {
    ids=($(get_window_ids "$workspace"))
    [[ ${#ids[@]} -gt 0 ]]
}

swaymsg() {
	(set -x; /usr/bin/swaymsg "$@")
}

# find outputs
outputs=($(swaymsg -t get_outputs | jq -r '.[]|.name'))
screens=${#outputs[@]}
numbers=$(seq 0 $((${#outputs[@]}-1)))
workspaces=($(seq 1 $screens | sed 's/^/kiosk/'))

# create workspaces
for number in $numbers; do
    workspace=${workspaces[number]}
    ids=($(get_window_ids "$workspace"))
    case "${#ids[@]}" in
        0)
	    url="${urls[$((number % ${#urls[@]}))]}"
            swaymsg "workspace $workspace"
            swaymsg "exec $browsercmd \"$url\""
            # wait up to 10s for window to appear
            waited=0
            while ! any_windows "$workspace" && [ $waited -lt 20 ]; do
                sleep 0.5
                waited=$((waited + 1))
            done
            ;;
        1)
            ;;
        *)
            for ((i = 1; i < ${#ids[@]}; i++)); do
		echo "Kill ${ids[i]}"
                swaymsg "[con_id=${ids[i]}] kill"
            done
            ;;
    esac
done

# move workspaces
for number in $numbers; do
    workspace=${workspaces[number]}
    output=${outputs[number]}
    swaymsg '[workspace="'$workspace'"] move workspace to '$output
    swaymsg '[workspace="'$workspace'"] focus'
done
{% endraw %}
